# Configuration template only. Credential fields are intentionally empty.
# Copy to .env for a new installation and configure secrets locally.
# Never commit .env or paste credentials into issues, screenshots or logs.

# Choose one provider: openai | fireworks | featherless | custom
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternatives: configure the provider you select.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
# FIREWORKS_VISION_MODEL=your-provider-vision-model
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Required for web login. Empty credentials disable successful sign-in.
WEB_LOGIN_USERNAME=
WEB_LOGIN_PASSWORD=

# Positive integers; invalid / nonpositive values fall back to defaults.
WEB_CHAT_SESSION_LIMIT_PER_MINUTE=30
WEB_CHAT_SERVER_DAILY_LIMIT=200

# Optional owner notifications. SMTP uses STARTTLS.
OWNER_NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Hosted deployment: final HTTPS origin, e.g. https://chat.example.com.
# Empty generates localhost reply links for use on the same computer.
OWNER_REPLY_BASE_URL=
OWNER_REPLY_TOKEN_TTL_HOURS=168

# Leave WEB_STATE_DIR UNSET to use .prosurface-agent/web-state.
# Overrides must name a private persistent directory outside the public root.
# Do not configure an empty value.
# WEB_STATE_DIR=/var/lib/prosurface-agent

# Photo bytes are not saved by default. Extracted text and visual descriptions
# may still be retained in conversation history.
SAVE_UPLOADS=0
